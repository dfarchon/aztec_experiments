{
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "check:testnet": "node scripts/check-testnet.mjs",
    "deploy:df:testnet": "bash scripts/with-toolchain.sh node scripts/deploy-billboard-testnet.mjs",
    "test:df:deployment": "node --test scripts/testnet/deployment.test.mjs",
    "test:df:release": "node --test scripts/testnet/release.test.mjs",
    "build:df": "bash scripts/with-toolchain.sh bash -c 'cd df-billboard && aztec compile'",
    "deploy:df:harness": "bash scripts/with-toolchain.sh node scripts/deploy-df-harness.mjs",
    "prepare:df:site": "node scripts/build-df-harness.mjs",
    "typecheck:df:site": "tsc -p apps/src/df-billboard-test/tsconfig.json",
    "lint:df:site": "eslint apps/src/df-billboard-test",
    "lint:fix:df:site": "eslint apps/src/df-billboard-test --fix",
    "prettier:df:site": "prettier --config apps/src/df-billboard-test/.prettierrc --write \"apps/src/df-billboard-test/**/*.{ts,tsx,mjs,css,json}\" eslint.config.mjs package.json",
    "prettier:check:df:site": "prettier --config apps/src/df-billboard-test/.prettierrc --check \"apps/src/df-billboard-test/**/*.{ts,tsx,mjs,css,json}\" eslint.config.mjs package.json",
    "format:df:site": "npm run lint:fix:df:site && npm run prettier:df:site",
    "format:check:df:site": "npm run prettier:check:df:site && npm run lint:df:site",
    "build:df:harness": "npm run typecheck:df:site && npm run prepare:df:site && vite build --config apps/src/df-billboard-test/vite.config.ts",
    "dev:df:site": "npm run prepare:df:site && vite --config apps/src/df-billboard-test/vite.config.ts",
    "preview:df:site": "vite preview --config apps/src/df-billboard-test/vite.config.ts",
    "dev:df:harness": "bash scripts/with-toolchain.sh bash scripts/run-df-test-site.sh",
    "test:df": "node --test scripts/test-df-message.mjs && bash scripts/with-toolchain.sh bash -c 'cd df-billboard && aztec test'",
    "test:df:message": "node --test scripts/test-df-message.mjs",
    "test:df:moderation": "node --test apps/src/df-billboard-test/moderation.test.mjs apps/src/df-billboard-test/keywords.test.mjs",
    "report:df:reading": "node scripts/build-df-report.mjs",
    "test:df:ui": "node --test apps/src/df-billboard-test/architecture.test.mjs apps/src/df-billboard-test/controller.test.mjs apps/src/df-billboard-test/metamask-posting.test.mjs apps/src/df-billboard-test/react.test.mjs apps/src/df-billboard-test/report.test.mjs apps/src/df-billboard-test/clock.test.mjs apps/src/df-billboard-test/l1.test.mjs apps/src/df-billboard-test/runtime-headers.test.mjs",
    "test:df:e2e": "bash scripts/with-toolchain.sh node scripts/test-df-e2e.mjs",
    "build:df:l1": "bash scripts/with-toolchain.sh bash -c 'cd df-billboard/portal && aztec-forge build'",
    "test:df:l1": "bash scripts/with-toolchain.sh bash -c 'cd df-billboard/portal && aztec-forge test'",
    "test:df:l1-request": "node --test apps/src/df-billboard-test/l1-request.test.mjs",
    "test:df:l1-post-lab:e2e": "node scripts/test-l1-post-lab-e2e.mjs",
    "build:contract": "bash scripts/with-toolchain.sh node scripts/build-contract.mjs",
    "build:portal": "bash scripts/with-toolchain.sh node scripts/build-portal.mjs",
    "test:sdk": "node scripts/test-sdk.mjs",
    "test:e2e": "node scripts/test-local-e2e.mjs",
    "start:local": "bash scripts/start-local.sh",
    "start:local:df": "SEQ_BLOCK_DURATION_MS=12000 bash scripts/start-local.sh",
    "test:noir": "bash scripts/with-toolchain.sh bash billboard/test/run_all.sh --noir-only",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:apps": "node apps/build.mjs",
    "test:daemon": "bash censor-daemon/run_tests.sh"
  },
  "dependencies": {
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-foundation/bb.js": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/kv-store": "6.0.0",
    "@aztec-foundation/noir-acvm_js": "6.0.0",
    "@aztec-labs/noir-contracts.js": "6.0.0",
    "@aztec-foundation/noir-noirc_abi": "6.0.0",
    "@aztec-labs/protocol-contracts": "6.0.0",
    "@aztec-labs/pxe": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallet-sdk": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "@fontsource/fira-sans": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "ethers": "^6.17.0",
    "fake-indexeddb": "^6.2.5",
    "linkifyjs": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@aztec-labs/bb-prover": "6.0.0",
    "@aztec-foundation/l1-artifacts": "6.0.0",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.1.2",
    "esbuild": "0.25.10",
    "esbuild-plugin-polyfill-node": "0.3.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.15.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vite": "7.3.1"
  }
}
