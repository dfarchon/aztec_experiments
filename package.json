{
  "private": true,
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "prepare:df": "node scripts/prepare-df.mjs",
    "build:df": "npm run prepare:df && bash scripts/with-toolchain.sh bash -c 'cd df-billboard && aztec compile'",
    "build:df:core": "npm run prepare:df && bash scripts/with-toolchain.sh bash -c 'cd .local/df-upstream/contracts && aztec compile'",
    "test:df:core": "bash scripts/with-toolchain.sh node scripts/test-df-e2e.mjs --df-core --real-proofs",
    "deploy:df:harness": "bash scripts/with-toolchain.sh node scripts/deploy-df-harness.mjs",
    "prepare:df:site": "node scripts/build-df-harness.mjs",
    "typecheck:df:site": "tsc -p apps/src/df-billboard-test/tsconfig.json",
    "build:df:harness": "npm run typecheck:df:site && npm run prepare:df:site && vite build --config apps/src/df-billboard-test/vite.config.ts",
    "dev:df:site": "npm run prepare:df:site && vite --config apps/src/df-billboard-test/vite.config.ts",
    "preview:df:site": "vite preview --config apps/src/df-billboard-test/vite.config.ts",
    "dev:df:harness": "bash scripts/with-toolchain.sh bash scripts/run-df-test-site.sh",
    "test:df": "npm run prepare:df && node --test scripts/test-df-message.mjs && bash scripts/with-toolchain.sh bash -c 'cd df-billboard && aztec test'",
    "test:df:message": "node --test scripts/test-df-message.mjs",
    "test:df:moderation": "node --test apps/src/df-billboard-test/moderation.test.mjs apps/src/df-billboard-test/keywords.test.mjs",
    "test:df:ui": "node --test apps/src/df-billboard-test/controller.test.mjs apps/src/df-billboard-test/react.test.mjs apps/src/df-billboard-test/report.test.mjs",
    "test:df:e2e": "bash scripts/with-toolchain.sh node scripts/test-df-e2e.mjs",
    "build:contract": "bash scripts/with-toolchain.sh node scripts/build-contract.mjs",
    "build:portal": "bash scripts/with-toolchain.sh node scripts/build-portal.mjs",
    "test:sdk": "node scripts/test-sdk.mjs",
    "test:e2e": "node scripts/test-local-e2e.mjs",
    "start:local": "bash scripts/start-local.sh",
    "start:local:df": "SEQ_BLOCK_DURATION_MS=12000 bash scripts/start-local.sh",
    "test:noir": "bash scripts/with-toolchain.sh bash billboard/test/run_all.sh --noir-only",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:apps": "node apps/build.mjs",
    "test:daemon": "bash censor-daemon/run_tests.sh"
  },
  "dependencies": {
    "@aztec/accounts": "5.0.1",
    "@aztec/aztec.js": "5.0.1",
    "@aztec/bb.js": "5.0.1",
    "@aztec/foundation": "5.0.1",
    "@aztec/kv-store": "5.0.1",
    "@aztec/noir-acvm_js": "5.0.1",
    "@aztec/noir-contracts.js": "5.0.1",
    "@aztec/noir-noirc_abi": "5.0.1",
    "@aztec/protocol-contracts": "5.0.1",
    "@aztec/pxe": "5.0.1",
    "@aztec/stdlib": "5.0.1",
    "@aztec/wallet-sdk": "5.0.1",
    "@aztec/wallets": "5.0.1",
    "@huggingface/transformers": "4.3.1",
    "ethers": "^6.17.0",
    "fake-indexeddb": "^6.2.5",
    "linkifyjs": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@aztec/bb-prover": "5.0.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.1.2",
    "big-integer": "1.6.52",
    "esbuild": "0.25.10",
    "esbuild-plugin-polyfill-node": "0.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
