# Copy to .env.local for local development/builds. Never commit private endpoints.
# Netlify: set these in the site's environment variables, with Builds scope.
NOTCH_NETWORK=testnet
# Optional public browser-accessible RPC overrides for the selected network:
# AZTEC_RPC_URL=https://your-aztec-rpc.example
# L1_RPC_URL=https://your-ethereum-rpc.example
# RPC URLs are included in the published frontend and are visible to visitors.
